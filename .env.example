# GRUS configuration
#
# Copy to .env and fill in. .env is gitignored and must stay that way —
# it holds the database password.

# Required
DB_PASSWORD=your-aurora-password

# Aurora
GRUS_DB_HOST=grus-db.cluster-xxxxxxxx.ap-south-1.rds.amazonaws.com
GRUS_DB_NAME=grus
GRUS_DB_USER=grusadmin
GRUS_DB_SCHEMA=grus

# AWS
AWS_REGION=ap-south-1
GRUS_BUCKET=your-bucket-name

# Bedrock models
GRUS_FAST_MODEL=qwen.qwen3-32b-v1:0
GRUS_REASONING_MODEL=qwen.qwen3-32b-v1:0
GRUS_EMBED_MODEL=amazon.titan-embed-text-v2:0

# SageMaker
SAGEMAKER_ROLE_ARN=arn:aws:iam::000000000000:role/your-sagemaker-role

# Local artefacts, relative to the code by default
# GRUS_MODEL_DIR=./model
# GRUS_TIER2_DIR=./tier2processed